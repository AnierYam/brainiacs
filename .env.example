DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
ALLOWED_HOSTS=your-service.onrender.com,your-custom-domain.com
# Backward-compatible fallback still supported:
# DJANGO_ALLOWED_HOSTS=your-service.onrender.com,your-custom-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-service.onrender.com,https://your-custom-domain.com
# Optional: provide a hosted Postgres URL. If omitted, SQLite will be used.
# DATABASE_URL=postgresql://username:password@host:5432/database

# Public site URL used for absolute links in emails.
SITE_URL=https://brainiacs.academy

# Email configuration for activation/sign-in notifications.
# Production default is SMTP; local DEBUG falls back to console only when EMAIL_HOST is empty.
EMAIL_PROVIDER=smtp
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-username
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=12
DEFAULT_FROM_EMAIL=Brainiacs <no-reply@brainiacs.academy>
SERVER_EMAIL=Brainiacs <no-reply@brainiacs.academy>
BRAINIACS_LOGIN_ALERT_COOLDOWN_SECONDS=43200
# Use your authenticated SMTP sender (recommended: same as EMAIL_HOST_USER).
BRAINIACS_OUTBOUND_FROM_EMAIL=your-smtp-username
BRAINIACS_SUPPORT_EMAIL=hello@brainiacs.academy
BRAINIACS_EMAIL_CONFIRM_TOKEN_MAX_AGE=86400

# SendGrid mode (optional)
# EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=your-sendgrid-api-key
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_HOST_USER=apikey

# Optional health-check recipient for:
# python manage.py check_email
TEST_EMAIL_TO=you@example.com

# Legacy fallback names still supported:
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.your-provider.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=your-smtp-username
# DJANGO_EMAIL_HOST_PASSWORD=your-smtp-password
# DJANGO_EMAIL_USE_TLS=True
# DJANGO_EMAIL_TIMEOUT=12
# DJANGO_DEFAULT_FROM_EMAIL=Brainiacs <no-reply@brainiacs.academy>

# Proxy behavior
# DJANGO_USE_X_FORWARDED_HOST=True
